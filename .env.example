# ─────────────────────────────────────────────────────────────────────────────
# Zeno — root environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development

# ── apps/api (Spring Boot) ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
API_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zeno
DB_USER=zeno
DB_PASSWORD=changeme
DB_URL=jdbc:postgresql://localhost:5432/zeno

# JWT / Auth
JWT_SECRET=change-this-development-secret-to-at-least-32-bytes
JWT_EXPIRY_MS=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.test
PASSWORD_RESET_EXPIRY_MINUTES=30
APP_FRONTEND_URL=http://localhost:5173

# ── apps/ai (Python / LangGraph AI Service) ─────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=
AI_SERVICE_ENABLED=true
AI_SERVICE_TIMEOUT_MS=15000
AI_RETRY_COUNT=1
AI_PORT=8001
PACK_DEFAULT_BUDGET_USD=0.05

# ── apps/web (React / Vite) ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=Zeno

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
