# =============================================================
# Niro — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================

# ----- Database -----
DATABASE_URL=jdbc:postgresql://localhost:5432/niro
DATABASE_USERNAME=niro
DATABASE_PASSWORD=niro

# ----- JWT -----
# Must be at least 32 characters (256 bits) for HS256
JWT_SECRET=change-this-secret-must-be-at-least-256-bits-long-for-hs256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60

# ----- Resend (transactional email) -----
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_ADDRESS=noreply@yourdomain.com

# ----- Frontend URL (used in email links + CORS) -----
APP_FRONTEND_URL=http://localhost:5173

# ----- AI Provider (optional — rule-based fallback used when disabled) -----
AI_ENABLED=false
AI_API_KEY=sk-your-openai-key-here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ----- Spring -----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── ML Service (Python FastAPI) ──────────────────────────────────────────
# Set to true to enable ML-augmented risk scoring (requires running ML service)
ML_SERVICE_ENABLED=false
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=5
ML_SERVICE_MAX_RETRIES=1
