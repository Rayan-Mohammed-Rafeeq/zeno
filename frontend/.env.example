# API Configuration
VITE_API_URL=http://localhost:8080/api

# Development
# Set to false to use real backend API instead of mock data
# VITE_MOCK_API=false

# Razorpay Standard Checkout — public key only (safe to expose to browser)
# Must match RAZORPAY_KEY_ID in backend/.env
# KEY_SECRET lives in backend/.env only — never add it here
VITE_RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
