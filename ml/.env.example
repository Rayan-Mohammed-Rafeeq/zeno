# Zeno ML Service - Environment Variables Template
# Copy this file to .env.ml for local development

# Model Directory
# Directory where trained model artifacts are stored
ZENO_MODEL_DIR=./data/artifacts/xgboost

# Service Configuration
# Host to bind the service (use 0.0.0.0 for all interfaces)
ML_SERVICE_HOST=0.0.0.0

# Port for the ML service
ML_SERVICE_PORT=8001

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Python Path (for module imports)
PYTHONPATH=./src

# Optional: MLflow Tracking
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=zeno-fraud-detection

# Optional: External Model Storage (S3, GCS, etc.)
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_DEFAULT_REGION=us-east-1
# MODEL_BUCKET=zeno-ml-models
