# ─── Zeno AI Service ─────────────────────────────────────────────────────────
# Copy to .env and fill in values before starting the service.

# LLM Provider: mock | openrouter | anthropic | openai | google
# Use "mock" for development/testing — no API key required.
LLM_PROVIDER=mock

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter (OpenAI-compatible; key is only required for this provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google (required when LLM_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Service auth — set a shared secret for service-to-service calls from Spring Boot
AI_SERVICE_API_KEY=

# Server
API_HOST=0.0.0.0
API_PORT=8001

# Logging
LOG_LEVEL=INFO

# Budget (USD per single refill analysis; empty = no limit)
PACK_DEFAULT_BUDGET_USD=0.05

# Environment tag
ENVIRONMENT=development
